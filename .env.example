# Copy to .env (gitignored) and fill in. Used by scripts/deploy.sh and
# scripts/preview-secure.sh.

# Password for private sections (daily/*). Injected at build time by the
# local section-privacy plugin; pages are encrypted by encrypted-pages.
# STATICRYPT_PASSWORD is accepted as a legacy fallback name.
SITE_PRIVATE_PASSWORD=change-me

# Absolute path of the Obsidian vault (the folder that contains .obsidian).
# scripts/sync-content.mjs collects every note with `publish: true` from it,
# and the vault-query plugin reads unpublished notes from it at build time.
# Quote the value if the path contains spaces.
OBSIDIAN_VAULT_ROOT="/path/to/your/vault"

# Optional. Notion page shown under the "Daily" category of the Private
# section. Read at build time and placed inside the encrypted page body, so it
# never appears in the repo or in plaintext HTML. Leave unset to hide the
# category.
#   - https://<workspace>.notion.site/ebd/<page-id>  -> embedded as an iframe
#     (requires the page to be published to the web; see Share > Publish >
#     "Embed this page" in Notion)
#   - any other URL (e.g. https://www.notion.so/...)  -> shown as a link only,
#     because Notion blocks iframes outside the /ebd/ path
# SITE_PRIVATE_NOTION_URL=
