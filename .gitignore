# ===========================
# Quartz + GitHub Actions 최적화 .gitignore
# ===========================

# Node.js 의존성
node_modules/

# 빌드 출력물 (GitHub Actions에서 매번 새로 빌드)
public/
.quartz-cache/

# Playwright MCP 테스트 산출물 (스크린샷, 콘솔 로그, 스냅샷)
.playwright/
.playwright-mcp/

# 환경 변수 및 비밀 정보
.env
.env.local
.env.*.local

# 에디터 설정
.vscode/
.idea/
*.swp
*.swo
*~

# macOS 시스템 파일
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows 시스템 파일
Thumbs.db
ehthumbs.db
Desktop.ini

# 로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 디버그 및 프로파일링
prof/
*.cpuprofile
*.heapprofile

# 테스트 커버리지
coverage/

# 임시 파일
*.tmp
*.temp
.cache/

# 콘텐츠 (로컬 Obsidian vault로의 심볼릭 링크 — 머신마다 경로가 다름)
content

# 빌드 캐시
tsconfig.tsbuildinfo

# npm 단일 체제 유지 (pnpm lockfile 커밋 방지)
pnpm-lock.yaml
